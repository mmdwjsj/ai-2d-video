{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@thai-video/core": ["packages/core/src/index.ts"],
      "@thai-video/core/*": ["packages/core/src/*"],
      "@thai-video/ai-providers": ["packages/ai-providers/src/index.ts"],
      "@thai-video/tts-providers": ["packages/tts-providers/src/index.ts"],
      "@thai-video/animation": ["packages/animation/src/index.ts"],
      "@thai-video/video-renderer": ["packages/video-renderer/src/index.ts"],
      "@thai-video/video-renderer/*": ["packages/video-renderer/src/*"]
    }
  }
}
