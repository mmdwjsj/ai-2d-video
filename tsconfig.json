{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "apps/server/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "packages/core/src/**/*.ts",
    "packages/ai-providers/src/**/*.ts",
    "packages/tts-providers/src/**/*.ts",
    "packages/animation/src/**/*.ts",
    "packages/video-renderer/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/web/dist",
    "packages/video-renderer/src/remotion/**"
  ]
}
