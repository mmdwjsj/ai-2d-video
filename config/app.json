{
  "schemaVersion": 1,
  "product": "thai-daily-life-ai-video",
  "video": {
    "aspectRatio": "9:16",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "container": "mp4",
    "videoCodec": "h264",
    "audioCodec": "aac",
    "audioIntermediate": "wav",
    "audioSampleRate": 48000,
    "audioChannels": 2,
    "durationSource": "final-audio-timeline"
  },
  "exportModes": ["zh", "th", "bilingual"],
  "defaultExportMode": "zh",
  "bilingualNote": "双语版默认面向中文观众：保留泰语人物对白 + 中文旁白/字幕",
  "storage": {
    "database": "data/workbench.sqlite",
    "projects": "data/projects",
    "assets": "assets",
    "output": "output"
  },
  "autosaveDebounceMs": 600,
  "maxShotVersions": 30,
  "task": {
    "pollIntervalMs": 500,
    "maxAttempts": 3
  }
}
